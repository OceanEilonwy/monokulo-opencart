<?xml version="1.0" encoding="UTF-8"?>
<!--
    The extension's tests, in four suites that run as separate PHPUnit
    processes (OpenCart's front end and admin each define the same constants,
    so one process can boot only one of them):

    - unit:     the framework-free library, no OpenCart (runs anywhere)
    - catalog:  the storefront side, booted in-process against a real
                OpenCart database (inside the opencart container)
    - admin:    the admin side, the same way
    - http:     real HTTP to the shop's Apache, webhooks and the Extension
                Installer included (names say over_http)
    - smoke:    against a real Monokulo (MONOKULO_URL), optional

    scripts/test runs them in the right order.
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="tests/bootstrap.php"
    colors="true"
    cacheDirectory=".phpunit.cache"
    executionOrder="defects"
    failOnWarning="true"
    failOnNotice="true"
    failOnDeprecation="true"
    failOnRisky="true"
    beStrictAboutOutputDuringTests="true"
    displayDetailsOnTestsThatTriggerDeprecations="true"
    displayDetailsOnTestsThatTriggerWarnings="true"
    displayDetailsOnTestsThatTriggerNotices="true"
>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="catalog">
            <directory>tests/Catalog</directory>
        </testsuite>
        <testsuite name="admin">
            <directory>tests/Admin</directory>
        </testsuite>
        <testsuite name="http">
            <directory>tests/Http</directory>
        </testsuite>
        <testsuite name="smoke">
            <directory>tests/Smoke</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
