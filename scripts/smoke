#!/bin/sh
# Runs the smoke suite against a fresh Monokulo on this machine's network
# (docker/monokulo-smoke.toml), then stops it. The shop must be up and the
# extension installed (scripts/test up && scripts/test install).
#
# Which Monokulo:
#   MONOKULO_BIN=/path/to/monokulo   a binary built from the pinned commit, or
#   MONOKULO_IMAGE=ghcr.io/...       its Docker image (the default:
#                                    monokulo:smoke, built by CI from the
#                                    commit in tests/vectors/PIN)
#
# MONOKULO_OPENAPI=/path/to/openapi.json is Monokulo's OpenAPI document
# written at that commit (`cargo xtask api openapi --out FILE` in a checkout
# of it), whose recorded examples the stand-in's answers are checked
# against. Required.
set -eu
cd "$(dirname "$0")/.."

if [ -z "${MONOKULO_OPENAPI:-}" ] || [ ! -s "$MONOKULO_OPENAPI" ]; then
	echo "set MONOKULO_OPENAPI to Monokulo's OpenAPI document written at the commit in tests/vectors/PIN (cargo xtask api openapi --out FILE)" >&2
	exit 1
fi

url=http://localhost:8081
# Another Monokulo on the port would be tested in this one's place.
if curl -s -o /dev/null "$url/"; then
	echo "something already answers on $url: stop it, then run this again" >&2
	exit 1
fi
# Its onion listener (docker/monokulo-smoke.toml) needs its port too: curl
# fails with 7 only when nothing listens.
listening=0
curl -s -o /dev/null --max-time 2 http://127.0.0.1:8082/ || listening=$?
if [ "$listening" != 7 ]; then
	echo "something already listens on 127.0.0.1:8082 (the smoke Monokulo's onion listener): stop it, then run this again" >&2
	exit 1
fi

data=$(mktemp -d)
key=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')

if [ -n "${MONOKULO_BIN:-}" ]; then
	MONOKULO_ENCRYPTION_KEY=$key "$MONOKULO_BIN" --options docker/monokulo-smoke.toml \
		--database-path "$data/monokulo.db" --logging-format json > "$data/monokulo.log" 2>&1 &
	pid=$!
	stop() { kill "$pid" 2>/dev/null || true; }
else
	chmod 777 "$data"
	docker run -d --rm --name monokulo-smoke --network host \
		-e MONOKULO_ENCRYPTION_KEY="$key" \
		-v "$PWD/docker/monokulo-smoke.toml:/etc/monokulo.toml:ro" -v "$data:/data" \
		"${MONOKULO_IMAGE:-monokulo:smoke}" monokulo --options /etc/monokulo.toml \
		--database-path /data/monokulo.db --logging-format json > /dev/null
	stop() { docker logs monokulo-smoke > "$data/monokulo.log" 2>&1 || true; docker stop monokulo-smoke > /dev/null 2>&1 || true; }
fi

cleanup() {
	status=$?
	stop
	if [ "$status" != 0 ]; then
		echo "--- Monokulo's log ---"
		tail -n 100 "$data/monokulo.log" 2>/dev/null || true
	fi
	rm -rf "$data"
	exit "$status"
}
trap cleanup EXIT INT TERM

for i in $(seq 1 60); do
	if curl -fs -o /dev/null "$url/status" || curl -s -o /dev/null -w '%{http_code}' "$url/" | grep -q 302; then
		break
	fi
	sleep 1
done

# Into the repository: the suite runs in the OpenCart container, which has it at /repo.
mkdir -p .phpunit.cache
cp "$MONOKULO_OPENAPI" .phpunit.cache/monokulo-openapi.json

MONOKULO_URL=$url MONOKULO_OPENAPI_FILE=/repo/.phpunit.cache/monokulo-openapi.json scripts/test smoke "$@"
