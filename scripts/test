#!/bin/sh
# Runs the extension's tests in the OpenCart container (docker/compose.yaml),
# as your own user so files it writes in the repository stay yours.
#
#   scripts/test up                 start OpenCart (PHP_VERSION=8.1|8.4|8.5) and install it
#   scripts/test install            build the zip and install it through the Extension Installer
#   scripts/test unit|catalog|admin|http|smoke [phpunit args]
#   scripts/test all                install, then every suite but smoke
#   scripts/test down               stop and remove the containers
#
# Coverage: COVERAGE=1 has each suite write coverage/raw/<suite>.cov (pcov)
# and `all` merge them into coverage/summary.txt and coverage/html/. The
# http suite runs the extension inside Apache, so only the in-process
# suites (unit, catalog, admin) count.
set -eu
cd "$(dirname "$0")/.."

compose() {
	docker compose -f docker/compose.yaml "$@"
}

run() {
	# umask 0: files the tests make in the shop (its log, cache) stay writable
	# by Apache, as Apache's stay writable by the tests.
	compose exec -T --user "$(id -u):$(id -g)" -e HOME=/tmp -e MONOKULO_URL="${MONOKULO_URL:-}" -w /repo opencart sh -c 'umask 0000 && exec "$@"' sh "$@"
}

suite() {
	name=$1
	shift
	if [ "${COVERAGE:-}" = 1 ]; then
		mkdir -p coverage/raw
		run php -d pcov.enabled=1 vendor/bin/phpunit --testsuite "$name" --coverage-php "coverage/raw/$name.cov" "$@"
	else
		run vendor/bin/phpunit --testsuite "$name" "$@"
	fi
}

case "${1:-all}" in
up)
	compose up -d --build --wait
	compose exec -T opencart oc-setup
	run composer install --no-interaction --no-progress
	;;
install)
	run php scripts/build-zip
	# Uninstalling deletes the extension's files: never let it follow the
	# development link into src/.
	compose exec -T opencart sh -c 'if [ -L /var/www/html/extension/monokulo ]; then rm /var/www/html/extension/monokulo && cp -a /repo/src /var/www/html/extension/monokulo && chown -R www-data:www-data /var/www/html/extension/monokulo; fi'
	suite http --group installer
	# From here on the shop runs src/ itself, so a change is live at once and
	# coverage names src/ files.
	compose exec -T opencart sh -c 'rm -rf /var/www/html/extension/monokulo && ln -s /repo/src /var/www/html/extension/monokulo'
	;;
down)
	compose down -v
	;;
all)
	"$0" install
	rm -rf coverage
	for name in unit catalog admin; do
		suite "$name"
	done
	COVERAGE='' suite http --exclude-group installer
	if [ "${COVERAGE:-}" = 1 ]; then
		run vendor/bin/phpcov merge --text coverage/summary.txt --html coverage/html coverage/raw > /dev/null
		cat coverage/summary.txt
	fi
	;;
unit | catalog | admin | http | smoke)
	name=$1
	shift
	suite "$name" "$@"
	;;
*)
	echo "usage: scripts/test up|install|unit|catalog|admin|http|smoke|all|down" >&2
	exit 2
	;;
esac
